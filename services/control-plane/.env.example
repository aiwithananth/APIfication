# Platform registry. Defaults to SQLite in .data/. For PostgreSQL:
# APF_DATABASE_URL=postgresql+psycopg://apification:apification@localhost:5432/apification
APF_DATA_DIR=.data
APF_SEED_DEMO=1
APF_CORS_ORIGINS=http://localhost:3000
# Outbound allowlist for HTTP nodes and custom model endpoints ("*" = development only)
APF_EGRESS_ALLOWLIST=*
